APP_NAME=MAM Age Gender Speech API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Path to Age-Gender-Classification/models
MODEL_ROOT=/data/Age-Gender-Classification/models
LOAD_TASKS=age,gender,gender_age

TARGET_SAMPLING_RATE=16000
MAX_AUDIO_SECONDS=60
MAX_UPLOAD_BYTES=26214400

API_PREFIX=/api/v1
CORS_ORIGINS=*
